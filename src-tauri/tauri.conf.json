{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "graze-tune",
  "version": "0.1.0",
  "identifier": "dev.lainarchive.grazetune",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      { "title": "graze-tune", "width": 1360, "height": 860, "minWidth": 1100, "minHeight": 700, "decorations": false, "center": true }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": { "../resources/": "./" },
    "windows": { "webviewInstallMode": { "type": "downloadBootstrapper" } }
  }
}
