{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "graze-tune",
  "version": "0.2.0",
  "identifier": "dev.lainarchive.grazetune",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      { "title": "graze-tune", "width": 1360, "height": 860, "minWidth": 1100, "minHeight": 700, "decorations": false, "center": true }
    ],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": { "../resources/": "./" },
    "windows": { "webviewInstallMode": { "type": "downloadBootstrapper" } }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ1MDJBNEQ2RUM4RjRERTAKUldUZ1RZL3MxcVFDUlZRR0haa3M1ajVNbHFhNE9LSVRUamRGZjZUc2doMVdpK2V6MUxaT0k1SVAK",
      "endpoints": ["https://github.com/lainarchive/graze-tune/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
